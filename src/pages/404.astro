---
import Base from '../layouts/Base.astro';
import { url } from '../lib';
---

<Base title="Page not found">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>This seat is empty.</h1>
      <p class="lede">The page you're looking for doesn't exist, but dinner is still on.</p>
      <div class="actions"><a class="btn" href={url()}>Back to the home page</a></div>
    </div>
  </section>
</Base>
