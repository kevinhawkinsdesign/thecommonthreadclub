---
import Base from '../layouts/Base.astro';
import Room from '../components/Room.astro';
import PlaceCard from '../components/PlaceCard.astro';
import LumaEvents from '../components/LumaEvents.astro';
import Arrow from '../components/Arrow.astro';
import { luma } from '../config';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const e = t[lang].events;
---

<Base lang={lang} title={e.title} description={e.intro}>
  <Room tone="aubergine" part="head" class="center">
    <h1 class="title">{e.title}</h1>
    <p class="intro">{e.intro}</p>
    <PlaceCard lang={lang} />
    <LumaEvents />
    {luma.calendarUrl && <p class="more"><a class="link" href={luma.calendarUrl}>{e.calendar}</a></p>}
  </Room>
  <Room tone="olive" part="foot">
    <h2 class="center formats__title">{e.formatsTitle}</h2>
    <div class="formats">
      {
        e.formats.map((f) => (
          <div>
            <h3>{f.name}</h3>
            <p>{f.body}</p>
          </div>
        ))
      }
    </div>
  </Room>
</Base>

<style>
  .title {
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    text-transform: uppercase;
  }
  .intro {
    margin: 1rem auto clamp(32px, 5vw, 56px);
    color: var(--ink-soft);
  }
  .more {
    margin-top: 2rem;
  }
  .formats__title {
    margin-bottom: 1em;
  }
  .formats {
    display: grid;
    gap: 28px 40px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    text-align: center;
  }
  .formats h3 {
    margin-bottom: 0.4em;
  }
  .formats p {
    margin-inline: auto;
    color: var(--ink-soft);
  }
</style>
