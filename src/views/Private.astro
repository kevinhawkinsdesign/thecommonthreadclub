---
import Base from '../layouts/Base.astro';
import Room from '../components/Room.astro';
import Arrow from '../components/Arrow.astro';
import Offer from '../components/Offer.astro';
import { contact } from '../config';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = t[lang].private;
const mailto = contact.email ? `mailto:${contact.email}?subject=${encodeURIComponent(p.title)}` : '';
---

<Base lang={lang} title={p.title} description={p.lede}>
  <Room tone="aubergine" part="head" class="center">
    <h1 class="title">{p.title}</h1>
    <p class="lede">{p.lede}</p>
  </Room>
  <Room tone="marigold">
    <div class="offers">
      {
        p.offers.map((o) => (
          <Offer icon={o.icon} name={o.name} body={o.body} />
        ))
      }
    </div>
  </Room>
  <Room tone="olive" part="foot" class="center">
    <h2>{p.askTitle}</h2>
    <p class="ask">{p.askBody}</p>
    <p class="actions">
      {mailto && <a class="btn" href={mailto}>{p.email} <Arrow /></a>}
      {contact.instagram && <a class:list={['btn', { 'btn--quiet': mailto }]} href={contact.instagram}>{p.dm} <Arrow /></a>}
    </p>
    {!mailto && !contact.instagram && <p>{p.soon}</p>}
  </Room>
</Base>

<style>
  .title {
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    text-transform: uppercase;
    margin-bottom: 0.4em;
  }
  .lede {
    margin-inline: auto;
    max-width: 26ch;
  }
  .offers {
    display: grid;
    gap: 32px 40px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    text-align: center;
  }

  .ask {
    margin: 1rem auto 1.8rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: none;
  }
</style>
