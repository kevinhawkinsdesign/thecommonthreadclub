---
// A loose spread of photos from past nights, like prints laid on the table.
import { getImage, Picture } from 'astro:assets';
import type { Moment } from '../data/moments';
import { t, type Lang } from '../i18n';
import { url } from '../lib';
import toastPoster from '../assets/moments/toast-poster.jpg';

interface Props {
  lang: Lang;
  items: Moment[];
  video?: boolean;
  columns?: 2 | 3;
}
const { lang, items, video = false, columns = 3 } = Astro.props;
const tilts = [-1.2, 0.8, -0.4, 1.1, -0.9, 0.5, -0.6, 1, -0.8, 0.6, -1, 0.7, -0.5];
const tilt = (i: number) => `--tilt: ${tilts[i % tilts.length]}deg`;
const poster = video ? await getImage({ src: toastPoster, width: 480, format: 'webp' }) : null;
const toast = t[lang].home.moments.toast;
---

<div class:list={['moments', `moments--${columns}`]}>
  {
    items.map((it, i) => (
      <figure style={tilt(i)}>
        <Picture src={it.src} alt={it.alt[lang]} widths={[320, 480, 720]} sizes="(min-width: 900px) 280px, 45vw" formats={['avif', 'webp']} loading="lazy" />
        <figcaption>{it.caption[lang]}</figcaption>
      </figure>
    ))
  }
  {
    poster && (
      <figure style={tilt(items.length)} class="moments__video">
        <video src={url('video/a-toast.mp4')} poster={poster.src} muted loop playsinline autoplay preload="none" aria-label={toast} />
        <figcaption>{toast}</figcaption>
      </figure>
    )
  }
</div>

<style>
  .moments {
    columns: 2 160px;
    column-gap: clamp(14px, 2.5vw, 24px);
  }
  @media (min-width: 760px) {
    .moments--3 {
      columns: 3;
    }
  }
  figure {
    break-inside: avoid;
    margin: 0 0 clamp(14px, 2.5vw, 24px);
    padding: 8px 8px 0;
    background: var(--cream);
    transform: rotate(var(--tilt));
    box-shadow:
      0 2px 3px rgb(51 4 40 / 0.08),
      0 18px 30px -18px rgb(51 4 40 / 0.5);
    transition: transform 0.4s var(--ease);
  }
  figure:hover {
    transform: rotate(0deg) scale(1.02);
  }
  video {
    display: block;
    width: 100%;
    aspect-ratio: 720 / 1160;
    object-fit: cover;
    background: var(--aubergine);
  }
  @media (prefers-reduced-motion: reduce) {
    figure,
    figure:hover {
      transform: none;
    }
    .moments__video {
      display: none;
    }
  }
  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    padding: 8px 4px 10px;
    font-size: 0.82rem;
    line-height: 1.35;
    color: var(--ink-soft);
    text-align: center;
  }
</style>
