---
// The brand logo from public/brand/. Until those files are added, a typeset
// stand-in keeps the header and head of the table intact.
import { asset } from '../lib';

interface Props {
  layout?: 'stacked' | 'horizontal';
  tone?: 'aubergine' | 'cream';
  class?: string;
}
const { layout = 'stacked', tone = 'aubergine', class: cls } = Astro.props;
const src = asset(`brand/logo-${layout}-${tone}.png`);
---

{
  src ? (
    <img class:list={['logo', `logo--${layout}`, cls]} src={src} alt="The Common Thread" decoding="async" />
  ) : (
    <span class:list={['logo', 'logo--type', `logo--${layout}`, cls]} style={`color: var(--${tone})`}>
      <span class="logo__the">The</span> <span class="logo__name">Common Thread</span>
    </span>
  )
}

<style>
  .logo {
    width: 100%;
    height: auto;
  }
  .logo--type {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    width: auto;
    line-height: 1;
    text-transform: uppercase;
  }
  .logo__the {
    font-family: var(--sans);
    font-weight: 500;
    letter-spacing: 0.32em;
    font-size: 0.3em;
    margin-bottom: 0.25em;
  }
  .logo__name {
    font-family: var(--display);
    letter-spacing: 0.02em;
    text-align: center;
  }
  .logo--type.logo--horizontal {
    flex-direction: row;
    align-items: baseline;
    gap: 0.5em;
    white-space: nowrap;
  }
  .logo--type.logo--horizontal .logo__the {
    font-size: 0.45em;
    margin: 0;
  }
</style>
