---
// A culinary trip, framed like a postcard from the road.
import { Picture } from 'astro:assets';
import type { Trip } from '../data/trips';
import type { Lang } from '../i18n';

interface Props {
  trip: Trip;
  lang: Lang;
}
const { trip, lang } = Astro.props;
---

<article class="trip">
  <Picture src={trip.image} alt={trip.imageAlt[lang]} widths={[360, 560, 800]} sizes="(min-width: 900px) 340px, 90vw" formats={['avif', 'webp']} loading="lazy" />
  <div class="trip__body">
    <p class="caps trip__place">{trip.place[lang]}</p>
    <h3>{trip.title[lang]}</h3>
    <p class="trip__summary">{trip.summary[lang]}</p>
  </div>
</article>

<style>
  .trip {
    background: var(--cream);
    padding: 10px;
    box-shadow:
      0 2px 3px rgb(51 4 40 / 0.08),
      0 20px 34px -22px rgb(51 4 40 / 0.5);
  }
  .trip :global(picture),
  .trip :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .trip__body {
    padding: 18px 12px 14px;
    text-align: center;
  }
  .trip__place {
    color: var(--rust);
    margin: 0 auto 0.5rem;
  }
  h3 {
    text-transform: none;
    font-size: clamp(1.3rem, 2vw, 1.5rem);
    line-height: 1.15;
  }
  .trip__summary {
    margin: 0.7rem auto 0;
    font-size: 0.98rem;
    max-width: 40ch;
    color: var(--ink-soft);
  }
</style>
