---
// A photo in the brand's arched frame (from the social templates).
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  position?: string;
}
const { src, alt, position = '50% 50%' } = Astro.props;
---

<div class="arch" style={`--pos: ${position}`}>
  <Picture src={src} alt={alt} widths={[320, 480, 720]} sizes="(min-width: 720px) 320px, 80vw" formats={['avif', 'webp']} loading="lazy" />
</div>

<style>
  .arch {
    width: clamp(220px, 26vw, 320px);
    max-width: 100%;
    margin-inline: auto;
    padding: 10px;
    background: var(--cream);
    border-radius: 999px 999px 4px 4px;
    box-shadow:
      0 2px 3px rgb(51 4 40 / 0.08),
      0 24px 40px -20px rgb(51 4 40 / 0.5);
  }
  .arch :global(picture),
  .arch :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: var(--pos);
    border-radius: 999px 999px 0 0;
  }
</style>
