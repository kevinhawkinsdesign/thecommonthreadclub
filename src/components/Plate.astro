---
// A round photo on the linen: plates are round. Empty slots show a bare plate.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src?: ImageMetadata | null;
  alt: string;
  size?: string;
  position?: string;
}
const { src, alt, size = 'clamp(220px, 30vw, 340px)', position = '50% 50%' } = Astro.props;
---

<div class:list={['plate', { 'plate--empty': !src }]} style={`--size: ${size}; --pos: ${position}`} aria-hidden={src ? undefined : 'true'}>
  {
    src && (
      <Picture
        src={src}
        alt={alt}
        widths={[320, 480, 720]}
        sizes="(min-width: 720px) 340px, 80vw"
        formats={['avif', 'webp']}
        loading="lazy"
      />
    )
  }
</div>

<style>
  .plate {
    position: relative;
    width: var(--size);
    max-width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    margin-inline: auto;
    background: var(--cream);
    padding: 6%;
    box-shadow:
      0 1px 0 rgb(51 4 40 / 0.06),
      0 18px 32px -12px rgb(51 4 40 / 0.4);
  }
  .plate::after {
    content: '';
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(255 252 245 / 0.35);
    pointer-events: none;
  }
  .plate :global(picture),
  .plate :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .plate :global(img) {
    object-fit: cover;
    object-position: var(--pos);
    border-radius: 50%;
  }
  .plate--empty {
    background:
      radial-gradient(circle, transparent 54%, color-mix(in srgb, var(--sand) 55%, transparent) 54.5% 55%, transparent 55.5%),
      var(--cream);
  }
</style>
