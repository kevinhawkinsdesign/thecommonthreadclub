---
// Ticket-style card for the promoted event. Renders nothing once it has passed.
import { upcomingEvent } from '../lib';

interface Props {
  tone?: 'light' | 'dark';
}

const { tone = 'light' } = Astro.props;
const event = upcomingEvent();
const details = event ? [event.time, event.location, event.price].filter(Boolean) : [];
---

{
  event && (
    <article class:list={['ticket', `ticket--${tone}`]} aria-labelledby="next-event-title">
      <div class="ticket__date" aria-hidden="true">
        <span class="ticket__wd">{event.weekdayShort}</span>
        <span class="ticket__day">{event.day}</span>
        <span class="ticket__mo">{event.monthShort}</span>
      </div>
      <div class="ticket__body">
        <p class="ticket__label">Next event · {event.longDate}</p>
        <h2 id="next-event-title" class="ticket__title">{event.title}</h2>
        {details.length > 0 && <p class="ticket__meta">{details.join(' · ')}</p>}
        {event.blurb && <p class="ticket__blurb">{event.blurb}</p>}
        <a class="btn ticket__btn" href={event.url}>
          Get tickets <span aria-hidden="true">→</span>
        </a>
        <p class="ticket__note">Limited seats · Booking via Luma</p>
      </div>
    </article>
  )
}

<style>
  .ticket {
    display: grid;
    grid-template-columns: auto 1fr;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--line);
    box-shadow: 0 24px 60px -30px rgb(0 0 0 / 0.45);
  }
  .ticket__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    padding: 24px 22px;
    background: var(--brass);
    color: var(--ink);
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    border-right: 2px dashed color-mix(in srgb, var(--ink) 25%, transparent);
  }
  .ticket__day {
    font-family: var(--font-display);
    font-size: 3.25rem;
    line-height: 1;
    letter-spacing: 0;
    font-weight: 500;
  }
  .ticket__body {
    padding: 28px;
  }
  .ticket__label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--wine);
    margin-bottom: 0.5rem;
  }
  .ticket__title {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin-bottom: 0.35em;
  }
  .ticket__meta {
    color: var(--ink-soft);
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .ticket__blurb {
    color: var(--ink-soft);
  }
  .ticket .ticket__btn {
    margin-top: 0.75rem;
    background: var(--wine);
    color: var(--cream);
    border-color: var(--wine);
  }
  .ticket .ticket__btn:hover {
    background: var(--wine-deep);
  }
  .ticket__note {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  @media (max-width: 420px) {
    .ticket {
      grid-template-columns: 1fr;
    }
    .ticket__date {
      flex-direction: row;
      gap: 10px;
      padding: 14px;
      border-right: 0;
      border-bottom: 2px dashed color-mix(in srgb, var(--ink) 25%, transparent);
    }
    .ticket__day {
      font-size: 1.6rem;
    }
  }
</style>
