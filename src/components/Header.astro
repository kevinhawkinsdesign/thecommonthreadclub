---
import { site, nav, luma } from '../config';
import { url, upcomingEvent } from '../lib';

const current = Astro.url.pathname;
const ticketsHref = upcomingEvent()?.url || luma.calendarUrl || url('events/');
---

<header class="header">
  <div class="wrap header__inner">
    <a class="logo" href={url()}>
      <span class="logo__mark" aria-hidden="true">✦</span>
      {site.name}
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => {
            const href = url(item.href);
            return (
              <li>
                <a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
        <li><a class="btn header__cta" href={ticketsHref}>Get tickets</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
    flex-wrap: wrap;
  }
  .logo {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .logo__mark {
    color: var(--brass);
  }
  ul {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 20px;
    list-style: none;
    margin: 0;
    padding: 8px 0;
  }
  nav a:not(.btn) {
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }
  nav a:not(.btn):hover,
  nav a[aria-current='page'] {
    color: var(--wine);
  }
  .header__cta {
    padding: 0.55em 1.1em;
    font-size: 0.9rem;
  }
  @media (max-width: 560px) {
    .header__inner {
      justify-content: center;
      padding-block: 8px;
    }
    ul {
      justify-content: center;
    }
  }
</style>
